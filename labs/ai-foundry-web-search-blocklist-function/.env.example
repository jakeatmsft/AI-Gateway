# Existing Foundry account and GPT-5.6 Luna deployment (required).
FOUNDRY_NAME=your-foundry-account
FOUNDRY_RESOURCE_GROUP=your-foundry-resource-group
FOUNDRY_DEPLOYMENT=gpt-5.6-luna
# Optional; defaults to the account's custom subdomain and the current subscription.
# FOUNDRY_ENDPOINT=https://your-foundry-account.openai.azure.com/openai/v1
# FOUNDRY_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

LAB_RESOURCE_GROUP=lab-ai-foundry-web-search-blocklist-function
LAB_LOCATION=westus2
LAB_APIM_SKU=Basicv2
# LAB_PUBLISHER_EMAIL=you@example.com

# Optional existing workspace for APIM GatewayLogs and response metric headers.
# LAB_LOG_ANALYTICS_WORKSPACE_ID=/subscriptions/.../resourceGroups/.../providers/Microsoft.OperationalInsights/workspaces/...
# Organization domains are in blocked-domains.json. Redeploy after changing it.

# Optional: reuse an existing gateway. Omit to provision a dedicated APIM service.
# APIM_SERVICE_ID=/subscriptions/.../resourceGroups/.../providers/Microsoft.ApiManagement/service/...
