# Copy to .env, or select an existing environment file with LAB_ENV_FILE.
APIM_SERVICE_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.ApiManagement/service/<apim-name>
APIM_SUBSCRIPTION_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1

# Reuse an existing Foundry APIM backend, or configure an existing endpoint.
# BACKEND_ID=foundry1
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com/

# Entra authentication uses APIM's system-assigned managed identity by default.
# Its Cognitive Services OpenAI User role is granted at Foundry account scope.
# Optional explicit scope (required for another subscription or custom hostname):
# AZURE_OPENAI_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.CognitiveServices/accounts/<account-name>
# For pools, supply a comma-separated list of all Foundry account resource IDs:
# AZURE_OPENAI_RESOURCE_IDS=<account-resource-id-1>,<account-resource-id-2>
# BACKEND_RESPONSES_PATH=/v1/responses

# Optional API key mode for a new backend only:
# AZURE_OPENAI_API_KEY=
# APIM_API_NAME=web-search-blocklist
# APIM_API_PATH=web-search/openai

# Omit when the APIM service already exports GatewayLogs to Azure Monitor.
# Otherwise use an existing workspace to enable export (at APIM service scope).
# APIM_LOG_ANALYTICS_WORKSPACE_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.OperationalInsights/workspaces/<workspace-name>

# Default: experimental HTTP-only Azure Function on one Linux B1 instance.
# Filesystem host keys, no AzureWebJobsStorage, and direct APIM reporting.
# ENABLE_STREAMING_PROXY=true
# STREAMING_PROXY_LOCATION=eastus
# For an APIM backend pool, explicitly choose the proxy's concrete upstream URL:
# STREAMING_PROXY_FOUNDRY_RESPONSES_URL=https://<resource>.openai.azure.com/openai/v1/responses
