<choose>
    <when condition="@((bool)context.Variables[&quot;response-is-streaming&quot;])">
        <set-header name="Authorization" exists-action="delete" />
        <set-header name="x-proxy-key" exists-action="delete" />
        <set-backend-service backend-id="{streaming-proxy-backend-id}" />
        <rewrite-uri template="/api/responses" copy-unmatched-params="true" />
    </when>
    <otherwise>
        {backend-authentication}
        <set-backend-service backend-id="{backend-id}" />
        <rewrite-uri template="{backend-responses-path}" copy-unmatched-params="true" />
    </otherwise>
</choose>
