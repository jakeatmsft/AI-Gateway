{
  "openapi": "3.0.1",
  "info": {
    "title": "Microsoft Web IQ",
    "description": "Microsoft Web IQ endpoints exposed through Azure API Management.",
    "version": "v3"
  },
  "paths": {
    "/search/web": {
      "post": {
        "summary": "Search the web",
        "description": "Returns ranked, citation-ready web results.",
        "operationId": "search-web",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "query"
                ],
                "properties": {
                  "query": {
                    "type": "string"
                  },
                  "maxResults": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 50
                  },
                  "language": {
                    "type": "string"
                  },
                  "region": {
                    "type": "string"
                  },
                  "maxLength": {
                    "type": "integer"
                  },
                  "contentFormat": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful search response"
          },
          "default": {
            "description": "Web IQ error response"
          }
        }
      }
    },
    "/browse": {
      "post": {
        "summary": "Browse a URL",
        "description": "Published to demonstrate an APIM policy that blocks the operation before it reaches Web IQ.",
        "operationId": "browse-url",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "contentFormat": {
                    "type": "string"
                  },
                  "maxLength": {
                    "type": "integer"
                  },
                  "liveCrawl": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful browse response"
          },
          "202": {
            "description": "Accepted for live crawl"
          },
          "default": {
            "description": "Web IQ error response"
          }
        }
      }
    }
  }
}
